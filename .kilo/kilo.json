{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "tradingview-analytics-stdio": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        ".",
        "tradingview-mcp"
      ],
      "enabled": true
    },
    "tradingview-analytics-sse": {
      "type": "remote",
      "url": "http://127.0.0.1:8001/sse",
      "enabled": true
    },
  }
}